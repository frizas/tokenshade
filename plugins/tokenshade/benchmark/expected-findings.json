{
  "schemaVersion": 1,
  "paths": [
    "AGENTS.md",
    "docs/mobile-package.md",
    "docs/asset-install.md",
    "docs/visual-system.md",
    "src/protocol.mjs",
    "src/catalog.mjs",
    "src/render.mjs",
    "src/reconnect.mjs"
  ],
  "findings": [
    {
      "id": "product-boundary",
      "all": ["reconnect", "src"],
      "any": ["product", "adapter", "boundary", "raybox"]
    },
    {
      "id": "mobile-install-gap",
      "all": ["mobile"],
      "any": ["zip", "bootstrap", "package", "packaging", "install", "installation", "extract", "activation"]
    },
    {
      "id": "mobile-buffer-portability",
      "all": ["mobile", "buffer"],
      "any": ["runtime", "portable", "portability", "api", "global"]
    }
  ]
}
